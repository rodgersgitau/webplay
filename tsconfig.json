{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "strict": true,
        "composite": true,
        "declaration": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "@valdadyne/webplay-core/*": [
                "packages/core/src/*"
            ],
            "@valdadyne/webplay-ui/*": [
                "packages/ui/src/*"
            ],
            "@valdadyne/webplay-eslint-config": [
                "packages/eslint-config/index.js"
            ]
        }
    }
}